# PostgreSQL (docker compose)
DB_PASSWORD=my_ledge_dev
DB_READONLY_PASSWORD=readonly_dev
POSTGRES_DB=my_ledge
POSTGRES_USER=my_ledge

# Backend runtime
DATABASE_URL=postgresql+asyncpg://my_ledge:my_ledge_dev@127.0.0.1:5432/my_ledge
SECRET_KEY=replace-me-too
API_KEY=replace-me
# docker compose build 시 frontend VITE_API_KEY 로도 같은 값이 자동 주입됨
EXCEL_PASSWORD=
CORS_ORIGINS=http://localhost:3000

# Optional Toss Securities credentials: backend only, blank disables integration.
# Prefer scripts/toss-with-1password.sh for runtime injection from your existing vault.
# Never prefix these with VITE_ or commit real credential values.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
